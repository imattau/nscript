// A private-message bot: open a NIP-17 gift-wrapped message addressed to us
// and, if it says `/status`, answer in a private message.
//
// `nip17.receive_private` opens the wrap and returns the PrivateMessage; the
// `private_message` permission it needs is declared below.
//
// Try it:
//
//   nscript check examples/private-message.ns
//   nscript inspect examples/private-message.ns
//
// `run` simulates every module operation and answers a record-returning one
// with placeholder text, so the handler reaches `receive_private` and then
// stops at `message.content`. The reply branch cannot be exercised in
// simulation; it needs a real NIP-17 host, which `nscript deploy` does not
// connect.
use nip17
use nip44
use nip46

signer account = nip46()
relayset inboxes = nip65_inboxes()

permissions {
    read GiftWrap from inboxes
    decrypt GiftWrap with account
    encrypt PrivateMessage with account
    publish GiftWrap to inboxes
    sign GiftWrap with account
    relay inboxes
    private_message
}

on GiftWrap where addressed_to == me {
    let message = nip17.receive_private(event)?

    if message.content == "/status" {
        send PrivateMessage {
            to: message.author,
            content: "NostrHost is online",
        } with account
    }
}
