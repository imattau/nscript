// A service bot that advertises what it can do (NCC-07): it publishes
// its own capability manifest — kind 30062, d=capabilities — on startup
// and then refreshes it every 24h, and it reads the manifests of peers
// it receives, selecting their capabilities with ncc07's pure functions.
//
// Adoption note: the manifest is this bot's own advertisement. NCC-07 §4
// is explicit that publishing a manifest says nothing about which NIPs
// the publisher actually implements — the declaration is not proof — so
// peers still verify capabilities for themselves.
//
// Try it:
//
//   nscript run examples/ncc07-capability-bot.ns
//       (no --event: publishes the manifest once at startup; the 24h
//       timer is registered for the refresh)
//
//   nscript run examples/ncc07-capability-bot.ns \
//       --event '{"event_type": "CapabilityManifest", "kind": 30062, "content": "", "tags": [["d", "capabilities"], ["cap", "ncc:05"], ["cap", "nip:17"]]}'
//       (matches the reader handler: selects the peer's capabilities)
use ncc07
use nip01
use nip46

signer account = nip46()
relayset public = configured

permissions {
    publish CapabilityManifest to public
    sign CapabilityManifest with account
    read CapabilityManifest from public
    relay public
    clock
    log
}

every 24h {
    // Startup runs the body once, then the interval refreshes it: the
    // manifest is published when the bot comes up and kept fresh after.
    let published = publish CapabilityManifest {
        d: "capabilities";
        content: "";
        cap: ["ncc:02", "ncc:05", "nip:01"];
    } to public with account
    print("capability manifest published: " + text(published.accepted) + "/1 relays")
}

on CapabilityManifest where tags.d contains "capabilities" {
    let advertised = ncc07.capabilities(event.tags)
    print("peer advertises " + text(len(advertised)) + " capabilities")
    if ncc07.supports(advertised, "ncc:05") {
        print("peer serves community profiles (ncc:05)")
    }
    if ncc07.capability_is_valid("ncc:05") {
        print("ncc:05 namespace: " + ncc07.capability_namespace("ncc:05"))
    }
}
