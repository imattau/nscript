// A poll-close bot: tallies `vote` tags on the closing note with a `for`
// loop and reassignable counters, then publishes the tally as a real
// signed reply.
//
// Try it:
//
//   nscript run examples/poll-tally-bot.ns \
//       --event '{"content": "closing the poll", "tags": [["t", "poll-close"], ["vote", "yes"], ["vote", "yes"], ["vote", "no"]]}'
//       (2 yes, 1 no: publishes "Poll closed: 2 yes, 1 no - yes wins")
//
//   nscript run examples/poll-tally-bot.ns \
//       --event '{"content": "closing the poll", "tags": [["t", "poll-close"], ["vote", "yes"], ["vote", "no"]]}'
//       (tied: publishes "Poll closed: 1 yes, 1 no - tied")
//
// `event.tags` iterates as one "name=value" text per tag (see
// docs/HANDLERS.md), so a `vote` tag arrives as the text "vote=yes" or
// "vote=no" and is matched with `contains` rather than read as a
// structured pair.
//
// An earlier version of this file could not publish the actual tally
// counts (only who won): `+` only joins two `Text`s or two `Int`s (see
// `arithmetic` in crates/nscript-runtime/src/eval.rs), and there was no
// int-to-text conversion, so `"count: " + yes` failed at run time despite
// checking clean. `text(value)` now exists for exactly this — it renders
// any value the same way `print` already does — so the tally below uses
// `text(yes)` / `text(no)` to build the real count into the message.
//
// (That same earlier version also had to work around `else if` not
// parsing, despite `spec/grammar.ebnf`'s own `if_stmt` production
// allowing it. That parser bug is fixed too, so the three-way branch
// below is a normal `if` / `else if` / `else` chain.)
use nip01
use nip46

signer account = nip46()
relayset public = configured

permissions {
    read Note from public
    publish Note to public
    sign Note with account
    relay public
    log
}

on Note where tags.t contains "poll-close" {
    let yes = 0
    let no = 0
    for tag in event.tags {
        if tag contains "vote=yes" {
            yes = yes + 1
        }
        if tag contains "vote=no" {
            no = no + 1
        }
    }
    let outcome = "tied"
    if yes > no {
        outcome = "yes wins"
    } else if no > yes {
        outcome = "no wins"
    }
    let result = publish Note {
        content: "Poll closed: " + text(yes) + " yes, " + text(no) + " no - " + outcome,
    } to public with account
    print(result.accepted)
}
