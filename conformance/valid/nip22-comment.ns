// NIP-22 carries distinct root scope and parent context. NIP-32 labels are
// embedded on the comment event through the `labels` field.
use nip22

permissions {
    comment
}

let result = nip22.publish_comment(Comment {
    root_tag: "E";
    root: "root-event-id";
    root_kind: 1;
    parent_tag: "e";
    target: "parent-event-id";
    parent_kind: 1111;
    content: "A useful comment";
    labels: [EmbeddedLabel { namespace: "moderation"; value: "helpful" }];
})
