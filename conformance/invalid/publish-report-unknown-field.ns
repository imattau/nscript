// error: E1101 publish-report-unknown-field
// A PublishReport has one field, `accepted`. The per-relay outcomes the host
// holds are not exposed to a script, so there is no `relays` to read.
use nip01
use nip46

signer account = nip46()
relayset public = configured

permissions {
    publish Note to public
    sign Note with account
    relay public
    log
}

on Note where tags.t contains "trigger" {
    let report = publish Note {
        content: "reply",
    } to public with account
    print(text(report.relays))
}
