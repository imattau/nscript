module nip14 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/14.md"

record NoteWithSubject {
    field content: Text
    field subject: Text
}

error SubjectError {
    field message: Text
}

operation publish_note_with_subject(note: NoteWithSubject) -> Result<PublishReport,SubjectError> effect Sign,Relay permission subject
