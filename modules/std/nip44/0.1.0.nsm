module nip44 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/44.md"

nominal EncryptedText from Bytes {
    require length(value) > 0
}

error EncryptionError {
    field message: Text
}

operation encrypt_text(plaintext: Text, recipient: PubKey) -> Result<EncryptedText,EncryptionError> effect Encrypt permission encrypt
operation decrypt_text(payload: EncryptedText, sender: PubKey) -> Result<Text,EncryptionError> effect Decrypt permission decrypt
