module nip73 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/73.md"

record ExternalComment {
    field content: Text
    field target_id: Text
    field target_kind: Text
}

error ExternalCommentError {
    field message: Text
}

operation publish_external_comment(comment: ExternalComment) -> Result<PublishReport,ExternalCommentError> effect Sign,Relay permission external_comment
