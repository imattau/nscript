module nip64 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/64.md"

record ChessGame {
    field pgn: Text
}

error ChessError {
    field message: Text
}

operation publish_chess_game(game: ChessGame) -> Result<PublishReport,ChessError> effect Sign,Relay permission chess
