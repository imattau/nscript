module nip03 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/03.md"

record TimestampAttestation {
    field target: EventId
    field target_kind: Int
    field ots_proof: Text
}

error TimestampError {
    field message: Text
}

operation publish_timestamp(attestation: TimestampAttestation) -> Result<PublishReport,TimestampError> effect Sign,Relay permission timestamp
