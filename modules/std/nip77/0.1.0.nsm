module nip77 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/77.md"

record SyncRequest {
    field relay: RelayUrl
    field cursor: Text
}

record SyncResult {
    field relay: RelayUrl
    field added: Int
    field removed: Int
}

error SyncError {
    field message: Text
}

operation synchronize(request: SyncRequest) -> Result<SyncResult,SyncError> effect Relay,Storage permission sync
