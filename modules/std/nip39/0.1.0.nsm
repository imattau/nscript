module nip39 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/39.md"

record ExternalIdentity {
    field platform: Text
    field proof: Text
}

record IdentityClaims {
    field claims: List<ExternalIdentity>
}

error IdentityError {
    field message: Text
}

operation publish_identity_claims(claims: IdentityClaims) -> Result<PublishReport,IdentityError> effect Sign,Relay permission identity_claims
