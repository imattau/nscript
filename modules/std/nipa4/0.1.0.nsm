module nipa4 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/A4.md"

record PublicMessage {
    field content: Text
    field recipients: List<PubKey>
}

error PublicMessageError {
    field message: Text
}

operation publish_public_message(message: PublicMessage) -> Result<PublishReport,PublicMessageError> effect Sign,Relay permission public_message
