module nip65 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/65.md"

record RelayList {
    field read: List<RelayUrl>
    field write: List<RelayUrl>
}

error RelayListError {
    field message: Text
}

operation publish_relay_list(list: RelayList) -> Result<PublishReport,RelayListError> effect Sign,Relay permission relay_list
