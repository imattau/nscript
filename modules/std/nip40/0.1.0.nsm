module nip40 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/40.md"

record ExpiringNote {
    field content: Text
    field expires_at: Int
}

error ExpirationError {
    field message: Text
}

operation publish_expiring_note(note: ExpiringNote) -> Result<PublishReport,ExpirationError> effect Sign,Relay permission expiration
