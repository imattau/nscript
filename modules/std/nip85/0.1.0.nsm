module nip85 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/85.md"
use nip01 @ "^0.1"

record Assertion {
    field subject: Text
    field kind: Text
    field value: Text
}

error AssertionError {
    field message: Text
}

operation publish_assertion(assertion: Assertion) -> Result<PublishReport,AssertionError> effect Sign,Relay permission assertion
