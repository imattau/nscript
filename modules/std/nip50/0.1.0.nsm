module nip50 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/50.md"

record SearchRequest {
    field query: Text
}

record SearchResults {
    field query: Text
    field count: Int
}

error SearchError {
    field message: Text
}

operation search_events(request: SearchRequest) -> Result<SearchResults,SearchError> effect Relay permission search
