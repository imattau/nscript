module nip09 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/09.md"

record DeletionRequest {
    field target: EventId
    field reason: Text
}

error DeletionRequestError {
    field message: Text
}

operation request_deletion(request: DeletionRequest) -> Result<PublishReport,DeletionRequestError> effect Sign,Relay permission deletion
