module nip25 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/25.md"

record Reaction {
    field target: EventId
    field content: Text
}

error ReactionError {
    field message: Text
}

operation publish_reaction(reaction: Reaction) -> Result<PublishReport,ReactionError> effect Sign,Relay permission reaction
