module nip99 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/99.md"

record Listing {
    field title: Text
    field summary: Text
    field content: Text
    field location: Text
    field price_amount: Text
    field price_currency: Text
}

error ListingError {
    field message: Text
}

operation publish_listing(listing: Listing) -> Result<PublishReport,ListingError> effect Sign,Relay permission listing
