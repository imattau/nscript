module nip66 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/66.md"

record RelayStatus {
    field relay: RelayUrl
    field uptime: Percentage
    field latency: Int
}

error RelayStatusError {
    field message: Text
}

operation publish_relay_status(status: RelayStatus) -> Result<PublishReport,RelayStatusError> effect Sign,Relay permission relay_monitor
