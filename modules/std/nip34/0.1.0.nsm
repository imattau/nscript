module nip34 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/34.md"

record Repository {
    field identifier: Text
    field name: Text
    field description: Text
    field clone_url: Text
    field web_url: Text
}

error RepositoryError {
    field message: Text
}

operation publish_repository(repository: Repository) -> Result<PublishReport,RepositoryError> effect Sign,Relay permission repository
