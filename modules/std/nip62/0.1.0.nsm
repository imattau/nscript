module nip62 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/62.md"

record VanishRequest {
    field relays: List<Text>
    field reason: Text
}

error VanishError {
    field message: Text
}

operation request_to_vanish(request: VanishRequest) -> Result<PublishReport,VanishError> effect Sign,Relay permission vanish
