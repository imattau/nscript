module nip52 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/52.md"

record CalendarEvent {
    field title: Text
    field start: Timestamp
    field end: Timestamp
    field location: Text
}

error CalendarError {
    field message: Text
}

operation publish_calendar_event(event: CalendarEvent) -> Result<PublishReport,CalendarError> effect Sign,Relay permission calendar
