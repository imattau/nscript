module nip23 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/23.md"
use nip01 @ "^0.1"

record Article {
    field identifier: Text
    field title: Text
    field content: Text
}

error ArticleError {
    field message: Text
}

operation publish_article(article: Article) -> Result<PublishReport,ArticleError> effect Sign,Relay permission article
