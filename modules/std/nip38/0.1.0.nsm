module nip38 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/38.md"
use nip01 @ "^0.1"

record UserStatus {
    field status: Text
    field content: Text
}

error StatusError {
    field message: Text
}

operation publish_status(status: UserStatus) -> Result<PublishReport,StatusError> effect Sign,Relay permission status
