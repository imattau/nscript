module ncc09 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/imattau/nostr-community-conventions/blob/186c3ad50966a2319c354ace12e0a5a2267b75d9/ncc-09/README.md"
use ncc02 @ "^0.1"

validator grant_status(value: Text) {
    require value == "active" or value == "revoked"
}

function operator(tags: List<Text>) -> Text
function service(tags: List<Text>) -> Text
function authority_status(tags: List<Text>) -> Text
function scopes(tags: List<Text>) -> List<Text>
function address(service: Text, operator: Text) -> Text
function scope_namespace(scope: Text) -> Text
function scope_is_valid(scope: Text) -> Bool
function grant_starts_at(tags: List<Text>, created_at: Int) -> Int
function grant_is_valid(tags: List<Text>, now: Int) -> Bool
function authorises(tags: List<Text>, scope: Text, now: Int) -> Bool

event AuthorityGrant {
    kind: 30064
    mode: addressable
    content: Text as text
    tags: List<AuthorityGrantTag> = []
    field d: Text
    field service: Text
    field p: Text
    field status: Text
    field scope: List<Text>
    field expiration: Int
    field valid_from: Int
    field note: Text
    require grant_status(status)
}
