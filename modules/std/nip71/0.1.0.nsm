module nip71 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/71.md"
use nip01 @ "^0.1"

record VideoEvent {
    field url: Text
    field caption: Text
}

error VideoError {
    field message: Text
}

operation publish_video(event: VideoEvent) -> Result<PublishReport,VideoError> effect Sign,Relay permission video
