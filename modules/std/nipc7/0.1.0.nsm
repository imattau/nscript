module nipc7 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/C7.md"

record ChatMessage {
    field content: Text
}

record ChatReply {
    field content: Text
    field target: EventId
}

error ChatError {
    field message: Text
}

operation send_chat_message(message: ChatMessage) -> Result<PublishReport,ChatError> effect Sign,Relay permission chat
operation reply_to_chat_message(reply: ChatReply) -> Result<PublishReport,ChatError> effect Sign,Relay permission chat
