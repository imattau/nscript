module nip01 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/01.md"

record MetadataContent {
    field name: Option<Text>
    field display_name: Option<Text>
    field about: Option<Text>
    field picture: Option<Text>
    field banner: Option<Text>
    field website: Option<Text>
    field nip05: Option<Text>
    field lud06: Option<Text>
    field lud16: Option<Text>
    field bot: Option<Bool>
}

event Note {
    kind: 1
    mode: regular
    content: Text as text
    tags: List<Tag> = []
}

event Metadata {
    kind: 0
    mode: replaceable
    content: MetadataContent as json<MetadataContent>
}

tag Person {
    wire: "p"
    field pubkey: PubKey at 1
    field relay: Option<RelayUrl> at 2
}

tag EventRef {
    wire: "e"
    field id: EventId at 1
    field relay: Option<RelayUrl> at 2
    field author: Option<PubKey> at 3
}
