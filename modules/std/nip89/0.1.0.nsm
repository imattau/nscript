module nip89 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/89.md"
use nip01 @ "^0.1"

record AppHandler {
    field kind: Text
    field app: Text
    field endpoint: Text
}

error HandlerError {
    field message: Text
}

operation publish_handler(handler: AppHandler) -> Result<PublishReport,HandlerError> effect Sign,Relay permission app_handler
