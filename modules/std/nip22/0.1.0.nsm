module nip22 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/22.md"
use nip01 @ "^0.1"

record Comment {
    field target: EventId
    field content: Text
}

error CommentError {
    field message: Text
}

operation publish_comment(comment: Comment) -> Result<PublishReport,CommentError> effect Sign,Relay permission comment
