module nip58 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/58.md"
use nip01 @ "^0.1"

record Badge {
    field identifier: Text
    field name: Text
    field description: Text
}

error BadgeError {
    field message: Text
}

operation publish_badge(badge: Badge) -> Result<PublishReport,BadgeError> effect Sign,Relay permission badge
