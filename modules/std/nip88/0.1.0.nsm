module nip88 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/88.md"

record PollOption {
    field id: Text
    field label: Text
}

record Poll {
    field question: Text
    field options: List<PollOption>
    field multiple_choice: Bool
    field ends_at: Int
}

record PollResponse {
    field poll: EventId
    field option: Text
}

error PollError {
    field message: Text
}

operation publish_poll(poll: Poll) -> Result<PublishReport,PollError> effect Sign,Relay permission poll
operation respond_to_poll(response: PollResponse) -> Result<PublishReport,PollError> effect Sign,Relay permission poll_response
