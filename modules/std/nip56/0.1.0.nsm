module nip56 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/56.md"
use nip01 @ "^0.1"

record Report {
    field target: Text
    field category: Text
    field content: Text
}

error ReportError {
    field message: Text
}

operation publish_report(report: Report) -> Result<PublishReport,ReportError> effect Sign,Relay permission report
