module nip02 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/02.md"

record FollowList {
    field people: List<PubKey>
}

error FollowListError {
    field message: Text
}

operation publish_follow_list(list: FollowList) -> Result<PublishReport,FollowListError> effect Sign,Relay permission follow_list
