module nip35 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/35.md"

record TorrentFile {
    field path: Text
    field bytes: Int
}

record Torrent {
    field title: Text
    field description: Text
    field info_hash: Text
    field files: List<TorrentFile>
    field trackers: List<Text>
}

error TorrentError {
    field message: Text
}

operation publish_torrent(torrent: Torrent) -> Result<PublishReport,TorrentError> effect Sign,Relay permission torrent
