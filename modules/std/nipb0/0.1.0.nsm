module nipb0 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/B0.md"

record Bookmark {
    field uri: Text
    field title: Text
    field description: Text
}

error BookmarkError {
    field message: Text
}

operation publish_bookmark(bookmark: Bookmark) -> Result<PublishReport,BookmarkError> effect Sign,Relay permission bookmark
