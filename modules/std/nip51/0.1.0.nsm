module nip51 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/51.md"

record UserList {
    field identifier: Text
    field members: List<PubKey>
}

error ListError {
    field message: Text
}

operation publish_user_list(list: UserList) -> Result<PublishReport,ListError> effect Sign,Relay permission list
