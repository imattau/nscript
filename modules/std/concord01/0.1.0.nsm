module concord01 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/ereignishorizont/concord/blob/main/CORD-01.md"
use nip44 @ "^0.1"
use nip59 @ "^0.1"

nominal SharedSecret from Bytes {
    require length(value) > 0
}

nominal DerivedKey from Bytes {
    require length(value) > 0
}

nominal SignedBytes from Bytes {
    require length(value) > 0
}

nominal SealedEvent from Bytes {
    require length(value) > 0
}

record StreamWrap {
    field kind: Integer
    field stream_pubkey: PubKey
    field sealed: SealedEvent
}

record StreamMessage {
    field author: PubKey
    field content: Text
}

error ConcordKeyError {
    field message: Text
}

error StreamMessageError {
    field message: Text
}

error ConcordWrapError {
    field message: Text
}

error ConcordSealError {
    field message: Text
}

operation derive_stream_key(secret: SharedSecret) -> Result<DerivedKey,ConcordKeyError> effect Encrypt permission concord_key_derivation
operation publish_message(stream: DerivedKey, message: StreamMessage) -> Result<PublishReport,StreamMessageError> effect Encrypt,Sign,Relay permission concord_publish
operation seal_message(stream: DerivedKey, payload: SignedBytes) -> Result<SealedEvent,ConcordSealError> effect Encrypt permission concord_seal
operation open_message(stream: DerivedKey, payload: SealedEvent) -> Result<SignedBytes,ConcordSealError> effect Decrypt permission concord_open
operation wrap_stream(stream: DerivedKey, payload: SealedEvent) -> Result<StreamWrap,ConcordWrapError> effect Encrypt permission concord_wrap
operation unwrap_stream(stream: DerivedKey, wrap: StreamWrap) -> Result<SealedEvent,ConcordWrapError> effect Decrypt permission concord_unwrap
