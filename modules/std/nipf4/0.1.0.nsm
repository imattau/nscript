module nipf4 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/F4.md"

record PodcastShow {
    field title: Text
    field description: Text
    field image: Text
    field website: Text
}

record PodcastEpisode {
    field title: Text
    field description: Text
    field content: Text
    field audio_url: Text
}

error PodcastError {
    field message: Text
}

operation publish_podcast_show(show: PodcastShow) -> Result<PublishReport,PodcastError> effect Sign,Relay permission podcast
operation publish_podcast_episode(episode: PodcastEpisode) -> Result<PublishReport,PodcastError> effect Sign,Relay permission podcast_episode
