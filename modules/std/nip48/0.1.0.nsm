module nip48 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/48.md"

record BridgedNote {
    field content: Text
    field source_id: Text
    field protocol: Text
}

error BridgeError {
    field message: Text
}

operation publish_bridged_note(note: BridgedNote) -> Result<PublishReport,BridgeError> effect Sign,Relay permission bridge
