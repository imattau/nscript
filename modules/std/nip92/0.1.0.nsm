module nip92 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/92.md"

record MediaAttachment {
    field url: Text
    field mime: Text
    field hash: Text
}

record NoteWithMedia {
    field content: Text
    field media: List<MediaAttachment>
}

error MediaError {
    field message: Text
}

operation publish_note_with_media(note: NoteWithMedia) -> Result<PublishReport,MediaError> effect Sign,Relay permission media
