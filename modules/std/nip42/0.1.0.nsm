module nip42 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/42.md"

record AuthenticatedRelay {
    field relay: RelayUrl
}

error RelayAuthError {
    field message: Text
}

operation authenticate(relay: RelayUrl) -> Result<AuthenticatedRelay,RelayAuthError> effect Sign,Relay permission relay_auth
