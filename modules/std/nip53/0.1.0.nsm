module nip53 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/53.md"
use nip01 @ "^0.1"

record LiveEvent {
    field identifier: Text
    field title: Text
    field summary: Text
}

error LiveEventError {
    field message: Text
}

operation publish_live_event(event: LiveEvent) -> Result<PublishReport,LiveEventError> effect Sign,Relay permission live_event
