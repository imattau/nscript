module nip10 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/10.md"
use nip01 @ "^0.1"

tag ReplyTo {
    wire: "e"
    field id: EventId at 1
    field relay: Option<RelayUrl> at 2
    literal "reply" at 3
    field author: Option<PubKey> at 4
}

record Reply {
    field target: EventId
    field root: EventId
    field content: Text
}

error ReplyError {
    field message: Text
}

operation publish_reply(reply: Reply) -> Result<PublishReport,ReplyError> effect Sign,Relay permission reply
