module nip57 @ 0.1.0
language ">=0.1.0 <0.2.0"
reference "https://github.com/nostr-protocol/nips/blob/master/57.md"

record ZapRequest {
    field recipient: PubKey
    field amount: Int
    field message: Text
}

record PaymentIntent {
    field recipient: PubKey
    field amount: Int
    field invoice: Text
}

error ZapError {
    field message: Text
}

operation create_zap_request(request: ZapRequest) -> Result<PaymentIntent,ZapError> effect Payment,Sign,Relay permission zap
